{
	"compilerOptions": {
		// 按 ES2022 语义检查源码；发布产物的运行时目标由 tsdown 单独指定。
		"target": "ES2022",
		// 保留 Vue TSX 语法，实际转换由 tsdown 中的 unplugin-vue-jsx 完成。
		"jsx": "preserve",
		// 使用 Vue 提供的 JSX 类型命名空间，避免依赖全局 JSX 声明。
		"jsxImportSource": "vue",
		// 覆盖现代浏览器、WebView 和可迭代 DOM 集合。
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		// 强制所有输入按模块处理，避免无 import/export 文件退化为全局脚本。
		"moduleDetection": "force",
		// 以 src 为声明模块根目录，避免发布产物保留多余的源码层级。
		"rootDir": "src",
		// 保留 ESM 语法交由 tsdown 构建。
		"module": "ESNext",
		// 按打包器规则解析 package exports 和 ESM。
		"moduleResolution": "Bundler",
		// 构建配置需要 Node.js 类型；发布声明不会暴露这些工程类型。
		"types": [
			"node",
			/** Element Plus 的 Volar 插件支持 */
			"element-plus/global"
		],
		// 启用全部严格类型检查。
		"strict": true,
		// 派生类覆盖成员时必须显式使用 override。
		"noImplicitOverride": true,
		// 动态索引签名必须使用方括号访问，避免误把未知字段当成固定属性。
		"noPropertyAccessFromIndexSignature": true,
		// 索引访问结果包含 undefined，强制处理缺失键。
		"noUncheckedIndexedAccess": true,
		// 未使用的局部变量和参数视为错误。
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		// 仅生成类型声明；JavaScript 产物统一由 tsdown 生成。
		"declaration": true,
		"emitDeclarationOnly": true,
		// 声明直接写入根发布目录。
		"outDir": "dist",
		// 兼容以默认导入形式使用 CommonJS 工程依赖。
		"esModuleInterop": true,
		// 防止大小写不同的导入路径在 Linux CI 中失效。
		"forceConsistentCasingInFileNames": true,
		// 每个文件必须可由 tsdown 独立转换。
		"isolatedModules": true,
		// 保留 ESM 导入导出，并要求类型导入显式使用 type。
		"verbatimModuleSyntax": true,
		// 跳过第三方声明文件噪声；包契约测试会检查真实消费者类型。
		"skipLibCheck": true
	},
	// 声明生成与常规类型检查共用源码和工程声明；typecheck 通过命令行 --noEmit 禁止写入。
	"include": ["src", "types"],
	// 排除依赖和发布产物。
	"exclude": ["node_modules", "dist"]
}
