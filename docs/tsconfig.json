{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"rootDir": "..",
		"types": ["node", "element-plus/global", "vitepress/client"],
		"declaration": false,
		"emitDeclarationOnly": false,
		"noEmit": true,
		"skipLibCheck": true
	},
	"include": [
		"../src/**/*.ts",
		"../src/**/*.tsx",
		"../types/**/*.d.ts",
		".vitepress/**/*.mts",
		".vitepress/**/*.ts",
		".vitepress/**/*.vue",
		"env.d.ts",
		"examples/**/*.vue"
	]
}
